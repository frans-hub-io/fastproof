{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "FastProof Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "quantity": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti|P|Pi|E|Ei)?$"
    },
    "duration": {
      "type": "string",
      "pattern": "^$|^[0-9]+[smhd]$"
    },
    "caRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingConfigMap": {
          "type": "string"
        },
        "key": {
          "$ref": "#/definitions/nonEmptyString"
        }
      },
      "not": {
        "properties": {
          "existingSecret": {
            "minLength": 1
          },
          "existingConfigMap": {
            "minLength": 1
          }
        },
        "required": [
          "existingSecret",
          "existingConfigMap"
        ]
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/quantity"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/quantity"
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "peers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ipBlock": {
            "type": "object",
            "required": [
              "cidr"
            ],
            "properties": {
              "cidr": {
                "type": "string"
              },
              "except": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "namespaceSelector": {
            "$ref": "#/definitions/labelSelector"
          },
          "podSelector": {
            "$ref": "#/definitions/labelSelector"
          }
        }
      }
    },
    "egressTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "to": {
          "$ref": "#/definitions/peers"
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "subchart": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "passwordRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "value": {
          "type": "string"
        }
      },
      "not": {
        "properties": {
          "existingSecret": {
            "minLength": 1
          },
          "value": {
            "minLength": 1
          }
        },
        "required": [
          "existingSecret",
          "value"
        ]
      }
    },
    "secretKeyRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "storageClass": {
          "type": "string"
        },
        "size": {
          "$ref": "#/definitions/quantity"
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "extraRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "api",
              "ingest",
              "writer",
              "sink",
              "scheduler"
            ]
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "startupProbe": {
          "$ref": "#/definitions/probe"
        },
        "readinessProbe": {
          "$ref": "#/definitions/probe"
        },
        "livenessProbe": {
          "$ref": "#/definitions/probe"
        },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "targetMemoryUtilizationPercentage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "pdb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "externalService": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^$|^https?://"
        },
        "user": {
          "type": "string"
        },
        "password": {
          "$ref": "#/definitions/passwordRef"
        },
        "ca": {
          "$ref": "#/definitions/caRef"
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^$|^https?://[^/]+(/.*)?$"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logFormat": {
          "enum": [
            "json",
            "text"
          ]
        },
        "logFilter": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "ui": {
          "type": "boolean"
        },
        "maxUploadBytes": {
          "type": "integer",
          "minimum": 1
        },
        "ingestWorkers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "retainUploads": {
          "type": "boolean"
        },
        "outboxRetentionDays": {
          "type": "integer",
          "minimum": 1
        },
        "logs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxLineBytes": {
              "type": "integer",
              "minimum": 256,
              "maximum": 1048576
            },
            "maxLinesPerRequest": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "maxRequestBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 268435456
            },
            "maxBytesPerLaunch": {
              "type": "integer",
              "minimum": 1024
            }
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "extraEnvFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "guards": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sseMaxPerCaller": {
              "type": "integer",
              "minimum": 1
            },
            "sseRecheckSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "heavyQueriesPerCaller": {
              "type": "integer",
              "minimum": 1
            },
            "maxConcurrentSpools": {
              "type": "integer",
              "minimum": 1
            },
            "bodyIdleTimeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "url": {
          "type": "string",
          "pattern": "^$|^postgres(ql)?://"
        },
        "maxConnections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "sslMode": {
          "enum": [
            "",
            "disable",
            "allow",
            "prefer",
            "require",
            "verify-ca",
            "verify-full"
          ]
        },
        "ca": {
          "$ref": "#/definitions/caRef"
        },
        "statementTimeoutSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "ingestReserve": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "job",
            "auto"
          ]
        },
        "job": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backoffLimit": {
              "type": "integer",
              "minimum": 0
            },
            "activeDeadlineSeconds": {
              "type": "integer",
              "minimum": 30
            },
            "podAnnotations": {
              "$ref": "#/definitions/stringMap"
            },
            "podLabels": {
              "$ref": "#/definitions/stringMap"
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        }
      }
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "enum": [
            "fs",
            "s3"
          ]
        },
        "fs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "existingClaim": {
                  "type": "string"
                },
                "storageClass": {
                  "type": "string"
                },
                "accessModes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "ReadWriteOnce",
                      "ReadWriteOncePod",
                      "ReadWriteMany"
                    ]
                  }
                },
                "size": {
                  "$ref": "#/definitions/quantity"
                },
                "annotations": {
                  "$ref": "#/definitions/stringMap"
                }
              }
            }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^$|^https?://"
            },
            "region": {
              "$ref": "#/definitions/nonEmptyString"
            },
            "bucket": {
              "type": "string",
              "pattern": "^$|^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
            },
            "pathStyle": {
              "type": "boolean"
            },
            "credentials": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingSecret": {
                  "type": "string"
                },
                "accessKeyKey": {
                  "$ref": "#/definitions/nonEmptyString"
                },
                "secretKeyKey": {
                  "$ref": "#/definitions/nonEmptyString"
                },
                "accessKey": {
                  "type": "string"
                },
                "secretKey": {
                  "type": "string"
                }
              }
            },
            "ca": {
              "$ref": "#/definitions/caRef"
            }
          }
        }
      }
    },
    "spool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeLimit": {
          "$ref": "#/definitions/quantity"
        },
        "medium": {
          "enum": [
            "",
            "Memory"
          ]
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adminTokens": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "$ref": "#/definitions/nonEmptyString"
            },
            "tokens": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+:[a-z0-9-]+:.{16,}$"
              }
            },
            "generate": {
              "type": "boolean"
            }
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingConfigMap": {
              "type": "string"
            },
            "key": {
              "$ref": "#/definitions/nonEmptyString"
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "permissions"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  },
                  "description": {
                    "type": "string"
                  },
                  "permissions": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "^(\\*|[a-z-]+:(\\*|[a-z-]+))$"
                    }
                  }
                }
              }
            },
            "bindings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "subject",
                  "role"
                ],
                "properties": {
                  "subject": {
                    "type": "string",
                    "pattern": "^(user|group|token):.+$"
                  },
                  "role": {
                    "type": "string"
                  },
                  "global": {
                    "type": "boolean"
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(\\*|[a-z0-9][a-z0-9-]{1,62})$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string",
          "pattern": "^$|^https?://"
        },
        "clientId": {
          "type": "string"
        },
        "clientSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "$ref": "#/definitions/nonEmptyString"
            },
            "value": {
              "type": "string"
            }
          }
        },
        "redirectUrl": {
          "type": "string",
          "pattern": "^$|^https?://.+/auth/callback$"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "usernameClaim": {
          "type": "string"
        },
        "groupsClaim": {
          "type": "string"
        },
        "allowedAlgs": {
          "type": "array",
          "items": {
            "enum": [
              "RS256",
              "PS256",
              "ES256",
              "EdDSA"
            ]
          }
        },
        "apiAudience": {
          "type": "string"
        },
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sessionTtl": {
          "$ref": "#/definitions/duration"
        },
        "sessionIdle": {
          "$ref": "#/definitions/duration"
        },
        "cookieName": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9_-]+$"
        },
        "postLogoutRedirect": {
          "type": "string"
        },
        "ca": {
          "$ref": "#/definitions/caRef"
        },
        "insecureCookie": {
          "type": "boolean"
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "clientCa": {
          "$ref": "#/definitions/caRef"
        }
      }
    },
    "externalValkey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "egressAllow": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "pattern": "^[^,\\s]+$",
            "maxLength": 300
          }
        },
        "secretsKey": {
          "$ref": "#/definitions/passwordRef"
        },
        "smtp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^$|^(smtps|smtp|smtp\\+insecure)://[^@/]+(:[0-9]+)?/?$"
            },
            "from": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "password": {
              "$ref": "#/definitions/passwordRef"
            }
          }
        },
        "telegramApiUrl": {
          "type": "string",
          "pattern": "^$|^https?://"
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxAttempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "backoffSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            }
          }
        }
      }
    },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^$|^https?://"
        },
        "protocol": {
          "enum": [
            "",
            "grpc",
            "http/protobuf",
            "http/json"
          ]
        },
        "serviceName": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "resourceAttributes": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "opsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "hostnames": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string"
          }
        },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request": {
              "type": "string"
            },
            "backendRequest": {
              "type": "string"
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topBranches": {
          "type": "integer",
