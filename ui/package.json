{
  "name": "fastproof-ui",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:real": "playwright test -c playwright.real.config.ts",
    "gen:api": "node scripts/gen-api.mjs ../schemas/openapi.json src/api/schema.gen.ts"
  },
  "dependencies": {
    "@franshub/ui-shell": "file:../../franshub-platform/packages/ui-shell",
    "@mantine/charts": "9.7.5",
    "@mantine/core": "9.7.5",
    "@mantine/hooks": "9.7.5",
    "@mantine/notifications": "9.7.5",
    "@tabler/icons-react": "3.50.0",
    "@tanstack/react-query": "5.107.1",
    "get-nonce": "1.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "react-virtuoso": "4.18.20",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "msw": "3.0.4",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "postcss-preset-mantine": "1.18.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "vitest": "5.1.0",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
