<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>FransHub.FastProof.Xunit</RootNamespace>
    <AssemblyName>FransHub.FastProof.Xunit</AssemblyName>
    <PackageId>FransHub.FastProof.Xunit</PackageId>
    <Description>FastProof reporter for xUnit.net v3: live results and logs, traceparent, secret masking and an offline spool.</Description>
    <PackageTags>fastproof;xunit;testing;reporting</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <ProjectReference Include="../FransHub.FastProof.Core/FransHub.FastProof.Core.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
