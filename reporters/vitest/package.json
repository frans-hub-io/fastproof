{
  "name": "@franshub/fastproof-vitest",
  "version": "0.1.0",
  "description": "Vitest reporter for FastProof: live results, logs, retries as attempts, traceparent, secret masking, offline spool and test plans.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./trace": {
      "types": "./dist/trace.d.ts",
      "default": "./dist/trace.js"
    },
    "./package.json": "./package.json",
    "./setup": {
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test build-test/test/*.test.js",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@franshub/fastproof-playwright": ">=0.1.0 <0.2.0",
    "vitest": ">=4.1.0"
  },
  "devDependencies": {
    "@franshub/fastproof-playwright": "file:../playwright",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
