      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.franshub</groupId>
      <artifactId>fastproof-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
