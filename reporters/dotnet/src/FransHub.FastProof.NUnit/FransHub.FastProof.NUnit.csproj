<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>FransHub.FastProof.NUnit</RootNamespace>
    <AssemblyName>FransHub.FastProof.NUnit</AssemblyName>
    <PackageId>FransHub.FastProof.NUnit</PackageId>
    <Description>FastProof reporter for NUnit 4: live results and logs, retries as attempts, traceparent, secret masking and an offline spool.</Description>
    <PackageTags>fastproof;nunit;testing;reporting</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.6.1" />
    <ProjectReference Include="../FransHub.FastProof.Core/FransHub.FastProof.Core.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
